{
  "version": 2,
  "installCommand": "npm install -g pnpm && pnpm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.js"
    }
  ],
  "functions": {
    "index.js": {
      "maxDuration": 30,
      "includeFiles": "db/**,middlewares/**,models/**,routes/**,services/**,utils/**,validation/**"
    }
  }
}
